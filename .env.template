# ===============================================
# MCP-7 Discovery Engine Environment Configuration
# ===============================================
# Copy this file to .env and fill in your values
# ===============================================

# GitHub API Configuration (REQUIRED for full functionality)
# Get your token at: https://github.com/settings/tokens
# Required scopes: public_repo (for public repositories)
# Rate limit: 5,000 requests/hour with token, 60 without
GITHUB_TOKEN=your_github_personal_access_token_here

# PulseMCP API Configuration (OPTIONAL)
# Contact PulseMCP for API access: https://www.pulsemcp.com
# If not set, the system will use mock data for testing
PULSEMCP_API_KEY=your_pulsemcp_api_key_here

# Database Configuration
# Path to SQLite database file (default: ./data/mcp-discovery.db)
DATABASE_PATH=./data/mcp-discovery.db

# Environment Configuration
# Options: development, production, test
NODE_ENV=development

# Logging Configuration
# Options: error, warn, info, debug
LOG_LEVEL=info

# Discovery Engine Configuration
# Maximum repositories to discover per run
MAX_REPOSITORIES=1000

# Minimum star count for repositories (filters out low-quality repos)
MIN_STARS=1

# Concurrency for parallel processing
CONCURRENCY=5

# GitHub API rate limit handling
# Delay between requests in milliseconds (helps avoid rate limits)
GITHUB_REQUEST_DELAY=100

# PulseMCP sync schedule (cron format)
# Default: Daily at 2 AM - "0 2 * * *"
PULSEMCP_SYNC_SCHEDULE="0 2 * * *"

# Health monitoring interval (in minutes)
# How often to check health of discovered MCPs
HEALTH_CHECK_INTERVAL=60

# Cache Configuration
# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# Enable mock mode for testing without API keys
# Set to true to use mock data instead of real APIs
MOCK_MODE=false

# Export Configuration
# Directory for exported data files
EXPORT_PATH=./data/exports

# Feature Flags
# Enable/disable specific features
ENABLE_GITHUB_DISCOVERY=true
ENABLE_PULSEMCP_SYNC=true
ENABLE_HEALTH_MONITORING=true
ENABLE_ML_CLASSIFICATION=false

# Performance Tuning
# Batch size for database operations
BATCH_SIZE=50

# Memory limit for Node.js process (in MB)
NODE_OPTIONS="--max-old-space-size=2048"

# Notification Configuration (future feature)
# Webhook URL for notifications about discovered MCPs
# NOTIFICATION_WEBHOOK_URL=https://your-webhook-url.com

# Analytics Configuration (future feature)
# Enable anonymous usage analytics
ENABLE_ANALYTICS=false

# Debug Configuration
# Enable verbose debug output
DEBUG=false

# Proxy Configuration (if behind corporate proxy)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1